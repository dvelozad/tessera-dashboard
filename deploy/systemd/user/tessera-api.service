[Unit]
Description=Tessera API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/deo/Documents/tessera-dashboard
EnvironmentFile=/home/deo/Documents/tessera-dashboard/.env
ExecStart=/home/deo/.venvs/tessera-py312/bin/python -m uvicorn mddatalake.api.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
