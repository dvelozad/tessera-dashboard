[Unit]
Description=Tessera transfer worker (hot cache to Google Drive)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/deo/Documents/tessera-dashboard
EnvironmentFile=/home/deo/Documents/tessera-dashboard/.env
ExecStart=/home/deo/.venvs/tessera-py312/bin/python -m mddatalake.cli.main worker
StandardOutput=append:/home/deo/.local/share/tessera/logs/worker.log
StandardError=append:/home/deo/.local/share/tessera/logs/worker.log
Restart=always
RestartSec=30
TimeoutStopSec=300

[Install]
WantedBy=default.target
