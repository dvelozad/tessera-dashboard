# ---------------------------------------------------------------------------
# Tessera configuration
# Every host-specific value lives here, so moving the service to another
# machine is a matter of editing this file, not the code.
# ---------------------------------------------------------------------------

# Database
DATABASE_URL=postgresql+asyncpg://mdrepo:mdrepo_dev_password@localhost:5433/mdrepo

# JWT
JWT_SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Storage backend: filesystem | s3 | gdrive
STORAGE_BACKEND=gdrive
STORAGE_ROOT=/var/lib/tessera/artifacts

# --- Google Drive cold tier (STORAGE_BACKEND=gdrive) -----------------------
# rclone remote name as configured in ~/.config/rclone/rclone.conf
GDRIVE_REMOTE=gdrive
# Folder inside the remote. Everything Tessera owns lives under this prefix.
GDRIVE_ROOT=tessera
# Optional: path to rclone.conf when the service user has no default config
# RCLONE_CONFIG_PATH=
# Optional bandwidth cap, e.g. 50M (bytes/s suffixes: k, M, G)
# RCLONE_BWLIMIT=
RCLONE_TRANSFERS=4
RCLONE_CHECKERS=8
RCLONE_DRIVE_CHUNK_SIZE=128M
RCLONE_TIMEOUT_SECONDS=21600
# Uploads are queued and pushed by `tessera worker` instead of blocking requests
GDRIVE_DEFER_UPLOADS=true
# Google Drive allows ~750 GiB of uploads per account per day; the worker
# pauses when the ledger for the UTC day reaches this value.
GDRIVE_DAILY_UPLOAD_GB=700
STORAGE_MANIFEST_ENABLED=true

# --- Hot cache -------------------------------------------------------------
# Bounded working set on local disk; evicted least-recently-used.
HOT_ROOT=/var/lib/tessera/hot
HOT_MAX_GB=10
HOT_KEEP_COPIES=true

# Staging area for `tessera pull`
STAGING_ROOT=/var/lib/tessera/staging

# --- S3/MinIO (STORAGE_BACKEND=s3) ----------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=md-simulations
S3_REGION=us-east-1

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Public entry point (nginx). Over Tailscale this is reached at
# http://bigmsi.tail500ddf.ts.net:8420 - 8420 was free on bigmsi.
TESSERA_HTTP_PORT=8420

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Ingestion
COMPRESS_TRAJECTORIES=true
COMPRESSION_FORMAT=gzip
CHECKSUM_ALGORITHM=sha256
MAX_FILE_SIZE_MB=51200
MAX_TOTAL_UPLOAD_SIZE_GB=200

# Optional: serve the built SPA from the API itself (single process, one port)
# FRONTEND_DIR=/opt/tessera/frontend/dist

# Preview extraction
# Above PREVIEW_MAX_FILE_SIZE_MB only this many bytes of the trajectory are read.
# 0 disables previews for oversized trajectories.
PREVIEW_MAX_FILE_SIZE_MB=1000
PREVIEW_HEAD_BYTES=268435456
